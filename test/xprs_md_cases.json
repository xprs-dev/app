{
 "about": "Formatted text (XPRS.md 4.11): input -> HTML that lib/util/xprs_md.dart gives. 'html' uses the options below, 'plain' none.",
 "options": {
  "img": "<img src=\"REF\" alt=\"ALT\"> (alt escaped & \" <)",
  "file": "<a data-ref=\"REF\">LABEL</a> (label escaped & <)",
  "mention": "<span class=\"at\">@CALL</span>"
 },
 "vectors": [
  {
